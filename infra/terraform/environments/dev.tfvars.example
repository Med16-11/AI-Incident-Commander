environment = "dev"
namespace   = "opsmind-dev"

resource_quota = {
  pods                   = "40"
  "requests.cpu"         = "8"
  "requests.memory"      = "16Gi"
  "limits.cpu"            = "16"
  "limits.memory"         = "32Gi"
  "requests.storage"      = "30Gi"
  persistentvolumeclaims = "5"
}
