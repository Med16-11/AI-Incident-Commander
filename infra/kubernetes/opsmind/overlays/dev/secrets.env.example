# Copy to secrets.env (ignored by git), set a random password, then use deploy-k8s.sh.
# URL-encode reserved characters in the PostgreSQL password embedded in the URL.
OPSMIND_DATABASE_URL=postgresql+psycopg://opsmind:CHANGE_ME@opsmind-postgres:5432/opsmind
OPSMIND_REDIS_URL=redis://redis:6379/0
OPSMIND_PROMETHEUS_URL=http://prometheus:9090
OPSMIND_PROMETHEUS_PROXY_URL=http://prometheus:9090
OPSMIND_LOKI_URL=http://loki:3100
OPSMIND_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
POSTGRES_PASSWORD=CHANGE_ME
OPSMIND_LOCAL_DEMO_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Optional integrations: add only the keys you configure; omit unused keys entirely.
# OPSMIND_LLM_API_KEY=
# OPSMIND_LLM_BASE_URL=https://your-approved-provider.example
# OPSMIND_LLM_MODEL=your-model
# OPSMIND_SLACK_BOT_TOKEN=
# OPSMIND_SLACK_SIGNING_SECRET=
# OPSMIND_SLACK_USER_TOKENS={}
# OPSMIND_SLACK_REMEDIATION_API_URL=http://opsmind-remediation-engine:8000
# OPSMIND_SLACK_INCIDENT_CHANNEL=C_DEV_INCIDENTS
# OPSMIND_CORRELATION_API_TOKEN=
# OPSMIND_INVESTIGATION_API_TOKEN=
