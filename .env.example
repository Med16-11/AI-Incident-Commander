# Optional local Compose overrides. Bind ports remain restricted to loopback.
OPSMIND_ENVIRONMENT=local
# Explicitly enable the local-only UI credential; set it using `openssl rand -hex 32`.
OPSMIND_LOCAL_DEMO_AUTH_ENABLED=true
OPSMIND_LOCAL_DEMO_TOKEN=
OPSMIND_LOG_LEVEL=INFO
OPSMIND_LOG_JSON=true
POSTGRES_DB=opsmind
POSTGRES_USER=opsmind
OPSMIND_POSTGRES_PORT=15432
OPSMIND_DATABASE_URL=postgresql+psycopg://opsmind@postgres:5432/opsmind
OPSMIND_REDIS_URL=redis://redis:6379/0
OPSMIND_REDIS_PORT=16379
OPSMIND_PROMETHEUS_URL=http://prometheus:9090
OPSMIND_LOKI_URL=http://loki:3100
OPSMIND_DETECTION_PROMETHEUS_JOB_REGEX=shopstack
OPSMIND_DETECTION_POLL_INTERVAL_SECONDS=30
OPSMIND_DETECTION_BASELINE_WINDOW=30
OPSMIND_DETECTION_BASELINE_MIN_SAMPLES=8
OPSMIND_DETECTION_BASELINE_DEVIATION_RATIO=0.5
OPSMIND_DETECTION_ERROR_RATE_THRESHOLD=0.05
OPSMIND_DETECTION_DEPENDENCY_ERROR_RATE_THRESHOLD=0.10
OPSMIND_DETECTION_LATENCY_P95_THRESHOLD_SECONDS=1.0
OPSMIND_DETECTION_Z_SCORE_THRESHOLD=3.5
OPSMIND_DETECTION_TRAFFIC_DROP_RATIO=0.50
OPSMIND_DETECTION_LOG_OCCURRENCE_THRESHOLD=5
OPSMIND_DETECTION_LOG_WINDOW_SECONDS=60
OPSMIND_DETECTION_CORRELATION_WINDOW_SECONDS=120
OPSMIND_DETECTION_DEDUPLICATION_TTL_SECONDS=900
OPSMIND_CORRELATION_BEFORE_SECONDS=600
OPSMIND_CORRELATION_AFTER_SECONDS=300
# Set a high-entropy local value to enable the internal correlation trigger.
OPSMIND_CORRELATION_API_TOKEN=
# Optional OpenAI-compatible provider configuration for the investigation engine.
OPSMIND_INVESTIGATION_API_TOKEN=
OPSMIND_LLM_BASE_URL=
OPSMIND_LLM_API_KEY=
OPSMIND_LLM_MODEL=
OPSMIND_LLM_TIMEOUT_SECONDS=30
OPSMIND_INVESTIGATION_MAX_TOOL_CALLS=12
OPSMIND_INVESTIGATION_MAX_EXECUTION_SECONDS=120
OPSMIND_INVESTIGATION_TOOL_TIMEOUT_SECONDS=15
OPSMIND_INVESTIGATION_MAX_CONTEXT_CHARS=48000
OPSMIND_INVESTIGATION_CONFIDENCE_THRESHOLD=0.75
OPSMIND_REMEDIATION_APPROVAL_TTL_SECONDS=900
# Optional Slack integration. Create a Slack app, then provide its bot token,
# request signing secret, and destination channel ID here (never commit secrets).
OPSMIND_SLACK_BOT_TOKEN=
OPSMIND_SLACK_SIGNING_SECRET=
OPSMIND_SLACK_INCIDENT_CHANNEL=
# JSON map from "team_id:slack_user_id" to that user's existing Remediation API bearer token.
# Keep the tokens in your secret manager or local .env; never commit populated values.
OPSMIND_SLACK_USER_TOKENS=
# Enable only when the remediation workload uses the scoped Kubernetes ServiceAccount.
OPSMIND_KUBERNETES_ENABLED=false
OPSMIND_KUBERNETES_NAMESPACE=shopstack
OPSMIND_KUBERNETES_REQUEST_TIMEOUT_SECONDS=5
OPSMIND_KUBERNETES_MAX_RETRIES=3
OPSMIND_KUBERNETES_RETRY_BACKOFF_SECONDS=0.2
OPSMIND_KUBERNETES_ROLLOUT_TIMEOUT_SECONDS=120
OPSMIND_KUBERNETES_DRY_RUN=false

# ShopStack local demo setting. Replace this placeholder before starting Compose.
SHOPSTACK_DB_PASSWORD=replace-me-with-a-local-password
GRAFANA_ADMIN_PASSWORD=replace-me-with-a-local-password
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3300
# Set any SERVICE to GATEWAY, USER, ORDER, INVENTORY, or PAYMENT for that container.
# Latency in ms; HTTP rates are 0..1; memory in MiB; CPU/timeout in ms; pool connections 0..5.
SHOPSTACK_PAYMENT_FAILURE_LATENCY_MS=0
SHOPSTACK_PAYMENT_FAILURE_HTTP_500_RATE=0
SHOPSTACK_PAYMENT_FAILURE_HTTP_429_RATE=0
SHOPSTACK_PAYMENT_FAILURE_MEMORY_MB=0
SHOPSTACK_PAYMENT_FAILURE_CPU_STRESS_MS=0
SHOPSTACK_PAYMENT_FAILURE_DEPENDENCY_TIMEOUT_MS=0
SHOPSTACK_PAYMENT_FAILURE_DB_CONNECTIONS=0
